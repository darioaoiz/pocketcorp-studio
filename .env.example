# Higgsfield API credentials.
#
# OPTIONAL. The easier route is the app's Settings page, which stores your key
# in a local database. Use this file instead if you'd rather keep the key out
# of the database, or run the app headless.
#
# Copy this file to `.env.local` and fill both values in. A Higgsfield key has
# TWO parts — create one at https://console.higgsfield.ai (API keys).
#
# `.env.local` is gitignored. Never commit it, and never put a real credential
# in `.env.example`.

HF_API_KEY_ID=
HF_API_KEY_SECRET=

# OPTIONAL. Redirects downloaded media to a folder outside this project — for
# example one synced by Google Drive or Dropbox, for automatic backup. Leave
# unset to keep media in the default `storage/media`. Never point this at the
# database; only media is safe to sync (see README > "Why files are downloaded").
# POCKETCORP_MEDIA_DIR=
